@page "/articles"
<PageTitle>Articles</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-12">
    <MudStack Spacing="6">
        <BackHomeButton Class="align-self-start" />
        
        <MudPaper Class="presentation-section pa-8" Elevation="0" Outlined="true">
            <MudStack Spacing="3">
                <MudText Typo="Typo.h3">Articles</MudText>
                <MudText Typo="Typo.body1" Class="presentation-description">
                    Notes on rendering, engine programming, and the technical details behind personal experiments.
                </MudText>
            </MudStack>
        </MudPaper>

        <MudDivider/>

        <MudStack Spacing="3" Class="articles-list">
            <ArticleCard Href="https://medium.com/%40logandvllrd/how-to-pick-a-3d-object-using-raycasting-in-c-39112aed1987"
                         Categories="@(["Engine", "Tutorial"])"
                         Title="How to pick a 3D object using raycasting in C++"
                         ImageSrc="images/articles/picker.png" />
            <ArticleCard Href="https://medium.com/%40logandvllrd/reverse-engineering-micro-machines-v4s-bonus-code-system-8e15830014f5?postPublishedType=initial"
                         Categories="@(["Reverse Engineering", "Story"])"
                         Title="Reverse-Engineering Micro Machines V4's Bonus Code System"
                         ImageSrc="images/articles/micromachines.png" />
        </MudStack>
    </MudStack>
</MudContainer>
